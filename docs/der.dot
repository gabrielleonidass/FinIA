digraph DER {
  graph [rankdir=LR, fontname="Inter", bgcolor="white", nodesep=0.5, ranksep=1.0, pad=0.3];
  node [shape=plain, fontname="Inter", fontsize=11];
  edge [fontname="Inter", fontsize=9, color="#64748b", arrowhead=crow, arrowtail=tee, dir=both];
  usuario [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>usuario</b></font></td></tr><tr><td align="left"><b>PK</b> id BIGINT<br align="left"/>nome VARCHAR(100)<br align="left"/>email VARCHAR(150) <b>UNIQUE</b><br align="left"/>cpf VARCHAR(11) <b>UNIQUE</b><br align="left"/>senha_hash VARCHAR(64)<br align="left"/>senha_salt VARCHAR(32)<br align="left"/>criado_em TIMESTAMP<br align="left"/></td></tr></table>>];
  categoria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>categoria</b></font></td></tr><tr><td align="left"><b>PK</b> id BIGINT<br align="left"/>nome VARCHAR(50) <b>UNIQUE</b><br align="left"/>tipo VARCHAR(10) (RECEITA | DESPESA)<br align="left"/>cor VARCHAR(7)<br align="left"/></td></tr></table>>];
  transacao [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>transacao</b></font></td></tr><tr><td align="left"><b>PK</b> id BIGINT<br align="left"/><b>FK</b> usuario_id<br align="left"/><b>FK</b> categoria_id<br align="left"/>descricao VARCHAR(150)<br align="left"/>valor DECIMAL(12,2)<br align="left"/>tipo VARCHAR(10) (RECEITA | DESPESA)<br align="left"/>data DATE<br align="left"/>categoria_automatica BOOLEAN<br align="left"/>confianca INT<br align="left"/></td></tr></table>>];
  meta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>meta</b></font></td></tr><tr><td align="left"><b>PK</b> id BIGINT<br align="left"/><b>FK</b> usuario_id<br align="left"/>nome VARCHAR(100)<br align="left"/>valor_alvo DECIMAL(12,2)<br align="left"/>valor_guardado DECIMAL(12,2)<br align="left"/>prazo DATE<br align="left"/>taxa_rendimento DECIMAL(6,3)<br align="left"/></td></tr></table>>];
  usuario -> transacao [label="  1 : N  "];
  categoria -> transacao [label="  1 : N  "];
  regra_categoria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>regra_categoria</b></font></td></tr><tr><td align="left"><b>PK</b> id BIGINT<br align="left"/><b>FK</b> usuario_id<br align="left"/><b>FK</b> categoria_id<br align="left"/>padrao VARCHAR(150)<br align="left"/>aceita BOOLEAN<br align="left"/>criada_em TIMESTAMP<br align="left"/></td></tr></table>>];
  usuario -> meta [label="  1 : N  "];
  usuario -> regra_categoria [label="  1 : N  "];
  categoria -> regra_categoria [label="  1 : N  "];
}
