digraph DER {
  graph [rankdir=LR, fontname="Inter", bgcolor="white", nodesep=0.35, ranksep=0.7, pad=0.3];
  node [shape=plain, fontname="Inter", fontsize=10];
  edge [fontname="Inter", fontsize=8, color="#64748b", arrowhead=crow, arrowtail=tee, dir=both];
  usuario [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>usuario</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>nome VARCHAR(120)<br align="left"/>email VARCHAR(150) UK<br align="left"/>cpf CHAR(11) UK<br align="left"/>senha_hash / senha_salt<br align="left"/>status VARCHAR(20)<br align="left"/>token_confirmacao<br align="left"/>prazo_confirmacao TIMESTAMP<br align="left"/>criado_em TIMESTAMP<br align="left"/></td></tr></table>>];
  categoria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>categoria</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>nome VARCHAR(60) UK<br align="left"/>cor CHAR(7)<br align="left"/>receita BOOLEAN<br align="left"/></td></tr></table>>];
  conta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>conta_financeira</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id<br align="left"/>apelido VARCHAR(60)<br align="left"/>instituicao VARCHAR(80)<br align="left"/>tipo VARCHAR(20)<br align="left"/>saldo_inicial DECIMAL(14,2)<br align="left"/>dia_vencimento INT<br align="left"/>ativa / open_finance BOOLEAN<br align="left"/></td></tr></table>>];
  transacao [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>transacao</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id, conta_id<br align="left"/>FK categoria_id<br align="left"/>data DATE<br align="left"/>descricao VARCHAR(200)<br align="left"/>valor DECIMAL(14,2)<br align="left"/>tipo (RECEITA|DESPESA)<br align="left"/>confianca DOUBLE<br align="left"/>status / origem<br align="left"/></td></tr></table>>];
  reclass [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>reclassificacao</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK transacao_id, usuario_id<br align="left"/>FK categoria_anterior_id<br align="left"/>FK categoria_nova_id<br align="left"/>padrao VARCHAR(120)<br align="left"/>data_hora TIMESTAMP<br align="left"/></td></tr></table>>];
  regra [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>regra_categorizacao</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id, categoria_id<br align="left"/>padrao VARCHAR(120)<br align="left"/>UK (usuario_id, padrao)<br align="left"/></td></tr></table>>];
  meta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>meta</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id<br align="left"/>nome VARCHAR(80)<br align="left"/>valor_alvo / valor_acumulado<br align="left"/>data_limite DATE<br align="left"/>taxa_rendimento_mensal<br align="left"/>status VARCHAR(20)<br align="left"/></td></tr></table>>];
  orcamento [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>orcamento</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id, categoria_id<br align="left"/>limite DECIMAL(14,2)<br align="left"/>mes_referencia CHAR(7)<br align="left"/></td></tr></table>>];
  alerta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>alerta</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id<br align="left"/>tipo VARCHAR(30)<br align="left"/>mensagem VARCHAR(300)<br align="left"/>lido BOOLEAN<br align="left"/></td></tr></table>>];
  config [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>configuracao_alerta</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK usuario_id<br align="left"/>tipo / ativo / canal<br align="left"/></td></tr></table>>];
  grupo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>grupo_familiar</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>nome VARCHAR(80)<br align="left"/>FK admin_id<br align="left"/></td></tr></table>>];
  membro [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#94a3b8"><tr><td bgcolor="#0f766e"><font color="white"><b>membro_grupo</b></font></td></tr><tr><td align="left">id BIGINT<br align="left"/>FK grupo_id<br align="left"/>nome / email<br align="left"/>permissao / status<br align="left"/></td></tr></table>>];
  usuario -> conta; usuario -> transacao; conta -> transacao; categoria -> transacao;
  transacao -> reclass; categoria -> reclass; usuario -> regra; categoria -> regra;
  usuario -> meta; usuario -> orcamento; categoria -> orcamento; usuario -> alerta; usuario -> config;
  usuario -> grupo; grupo -> membro;
}
