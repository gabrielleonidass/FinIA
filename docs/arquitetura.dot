digraph A {
  graph [rankdir=TB, fontname="Inter", nodesep=0.5, ranksep=0.45, pad=0.3];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=11, color="#94a3b8", fillcolor="#f8fafc", margin="0.25,0.12"];
  edge [color="#64748b", fontname="Inter", fontsize=9];
  user [label="Usuário (navegador / celular)", fillcolor="#ccfbf1"];
  front [label=<<b>Front-end</b> (HTML + CSS + JavaScript + Chart.js)<br/><font point-size="9">Login · Cadastro · Início · Transações · Metas</font>>];
  ctrl [label=<<b>Controllers</b> (recebem as requisições)<br/><font point-size="9">AuthController · InicioController · TransacaoController · MetaController</font>>, fillcolor="#f0fdfa"];
  srv [label=<<b>Services</b> (regras de negócio)<br/><font point-size="9">UsuarioService · TransacaoService · CategorizadorService (IA) · MetaService · InicioService</font>>, fillcolor="#f0fdfa"];
  repo [label=<<b>Repositories</b> (SQL via JDBC)<br/><font point-size="9">UsuarioRepository · CategoriaRepository · TransacaoRepository · MetaRepository</font>>, fillcolor="#f0fdfa"];
  db [label=<<b>Banco H2</b><br/><font point-size="9">./data/finia_simples.mv.db · 4 tabelas</font>>, shape=cylinder, fillcolor="#e0f2fe"];
  user -> front [label=" HTTP"];
  front -> ctrl [label=" fetch() com JSON"];
  ctrl -> srv; srv -> repo; repo -> db [label=" JDBC"];
  subgraph cluster_back { label="Back-end Java 17"; fontname="Inter"; fontsize=10; style="rounded,dashed"; color="#0f766e"; ctrl; srv; repo; }
}
